        "from skimage import data, exposure, color, img_as_float\n",
        "\n",
        "# 1. Memuat citra dan membuat versi kontras rendah\n",
        "image = data.camera()  # Citra grayscale asli\n",
        "image_low_contrast = exposure.rescale_intensity(image, in_range=(50, 200))  # Buat kontras rendah\n",
        "image_low_contrast = img_as_float(image_low_contrast)\n",
        "\n",
        "# 2. Metode 1: Contrast Stretching\n",
        "# Cari nilai minimum dan maksimum dari citra\n",
        "p2, p98 = np.percentile(image_low_contrast, (2, 98))\n",
        "image_stretched = exposure.rescale_intensity(image_low_contrast, in_range=(p2, p98))\n",
        "\n",
        "# 3. Metode 2: Histogram Equalization\n",
        "image_eq = exposure.equalize_hist(image_low_contrast)\n",
