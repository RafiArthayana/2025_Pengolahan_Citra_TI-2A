        "Praktikum 7. Filter Median vs Filter Rata-rata"
      ],
      "metadata": {
        "id": "5FtyNsk9kN7M"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from skimage import data, util, filters, img_as_float, color, morphology\n",
        "from scipy.ndimage import convolve\n",
        "\n",
        "# Fungsi pembantu: Filter rata-rata dengan kernel 3x3\n",
        "def apply_average_filter(image):\n",
        "    kernel = np.ones((3, 3)) / 9\n",
        "    return convolve(image, kernel, mode='reflect')\n",
        "\n",
        "# Fungsi pembantu: Filter median dengan disk radius 1\n",
        "def apply_median_filter(image):\n",
        "    return filters.median(image, morphology.disk(1))\n",
        "\n",
        "# Fungsi pemrosesan dan visualisasi\n",
        "def compare_filters(image_input, title=\"\"):\n",
        "    image = img_as_float(image_input)\n",
        "\n",
        "    # Tambahkan noise salt & pepper\n",
        "    noisy = util.random_noise(image, mode='s&p', amount=0.05)\n",
        "\n",
        "    # Terapkan filter rata-rata dan median\n",
        "    avg_filtered = apply_average_filter(noisy)\n",
        "    median_filtered = apply_median_filter(noisy)\n",
        "\n",
        "    # Plot hasil\n",
        "    fig, axes = plt.subplots(1, 4, figsize=(16, 4))\n",
        "    axes[0].imshow(image, cmap='gray')\n",
        "    axes[0].set_title(f\"{title} - Original\")\n",
        "    axes[0].axis('off')\n",
        "\n",
        "    axes[1].imshow(noisy, cmap='gray')\n",
        "    axes[1].set_title(\"With Salt & Pepper Noise\")\n",
        "    axes[1].axis('off')\n",
        "\n",
        "    axes[2].imshow(avg_filtered, cmap='gray')\n",
        "    axes[2].set_title(\"Average Filter\")\n",
        "    axes[2].axis('off')\n",
        "\n",
        "    axes[3].imshow(median_filtered, cmap='gray')\n",
        "    axes[3].set_title(\"Median Filter\")\n",
        "    axes[3].axis('off')\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "# 1. Uji pada citra grayscale \"camera\"\n",
        "camera_img = data.camera()\n",
        "compare_filters(camera_img, title=\"Camera\")\n",
        "\n",
        "# 2. Uji pada citra berwarna \"astronaut\" yang dikonversi ke grayscale\n",
        "astronaut_rgb = data.astronaut()\n",
        "astronaut_gray = color.rgb2gray(astronaut_rgb)\n",
        "compare_filters(astronaut_gray, title=\"Astronaut (Grayscale)\")\n"
      ],
