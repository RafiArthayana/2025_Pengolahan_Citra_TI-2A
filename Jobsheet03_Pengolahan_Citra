        "Praktikum 5. Eksperimen Transformasi Intensitas Lain"
      ],
      "metadata": {
        "id": "DWuf6UQgj_TF"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from skimage import data, color, img_as_float\n",
        "\n",
        "# --- PARAMETER ---\n",
        "c_log = 1.0\n",
        "gamma = 2.2\n",
        "\n",
        "# --- Citra 1: CAMERA ---\n",
        "img_camera = img_as_float(data.camera())\n",
        "img_camera_log = c_log * np.log1p(img_camera)\n",
        "img_camera_log /= img_camera_log.max()\n",
        "img_camera_gamma = np.power(img_camera, gamma)\n",
        "\n",
        "# --- Citra 2: ASTRONAUT (grayscale) ---\n",
        "astro_rgb = data.astronaut()\n",
        "img_astro_gray = color.rgb2gray(astro_rgb)\n",
        "img_astro_log = c_log * np.log1p(img_astro_gray)\n",
        "img_astro_log /= img_astro_log.max()\n",
        "img_astro_gamma = np.power(img_astro_gray, gamma)\n",
        "\n",
        "# --- Fungsi plot per citra ---\n",
        "def plot_image_and_hist(ax_img, ax_hist, image, title, color='gray'):\n",
        "    ax_img.imshow(image, cmap='gray')\n",
        "    ax_img.set_title(title)\n",
        "    ax_img.axis('off')\n",
        "    ax_hist.hist(image.ravel(), bins=256, range=(0,1), color=color, alpha=0.75)\n",
        "    ax_hist.set_xlim(0,1)\n",
        "    ax_hist.set_title(\"Histogram\")\n",
        "\n",
        "# --- Buat subplots ---\n",
        "fig, axes = plt.subplots(nrows=6, ncols=2, figsize=(12, 15))\n",
        "\n",
        "# CAMERA\n",
        "plot_image_and_hist(axes[0,0], axes[0,1], img_camera, \"Camera - Original\")\n",
        "plot_image_and_hist(axes[1,0], axes[1,1], img_camera_log, f\"Camera - Log (c={c_log})\")\n",
        "plot_image_and_hist(axes[2,0], axes[2,1], img_camera_gamma, f\"Camera - Gamma (γ={gamma})\")\n",
        "\n",
        "# ASTRONAUT\n",
