        "## Penugasan 2 : Template Matching Invariant"
      ],
      "metadata": {
        "id": "Y7iGLSDKU56u"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from skimage import data\n",
        "from skimage.feature import match_template\n",
        "from skimage.transform import rotate, rescale\n",
        "\n",
        "# Muat citra dan template asli\n",
        "image = data.coins()\n",
        "template = image[15:80, 190:260]  # Template asli (koin kanan atas)\n",
        "\n",
        "# Modifikasi template: rotasi dan skala\n",
        "template_rotated = rotate(template, angle=45, resize=True)\n",
        "template_scaled = rescale(template, scale=1.5, anti_aliasing=True)\n",
        "\n",
        "# Matching dengan template yang dirotasi\n",
        "result_rotated = match_template(image, template_rotated)\n",
        "ij_rot = np.unravel_index(np.argmax(result_rotated), result_rotated.shape)\n",
        "x_rot, y_rot = ij_rot[::-1]\n",
        "\n",
        "# Matching dengan template yang diskalakan\n",
        "result_scaled = match_template(image, template_scaled)\n",
        "ij_scl = np.unravel_index(np.argmax(result_scaled), result_scaled.shape)\n",
        "x_scl, y_scl = ij_scl[::-1]\n",
        "\n",
        "# Tampilkan hasil pencocokan template rotasi\n",
        "fig1, ax1 = plt.subplots(1, 3, figsize=(12, 6))\n",
        "ax1[0].imshow(image, cmap='gray')\n",
        "ax1[0].set_title('Target Image')\n",
        "ax1[0].axis('off')\n",
        "\n",
        "ax1[1].imshow(template_rotated, cmap='gray')\n",
        "ax1[1].set_title('Template Rotated 30°')\n",
        "ax1[1].axis('off')\n",
        "\n",
        "ax1[2].imshow(result_rotated, cmap='viridis')\n",
        "ax1[2].set_title('Matching Result (Rotated)')\n",
        "ax1[2].plot(x_rot, y_rot, 'r+', markersize=10)\n",
        "ax1[2].axis('off')\n",
        "\n",
        "# Tampilkan hasil pencocokan template skala\n",
        "fig2, ax2 = plt.subplots(1, 3, figsize=(12, 6))\n",
        "ax2[0].imshow(image, cmap='gray')\n",
        "ax2[0].set_title('Target Image')\n",
        "ax2[0].axis('off')\n",
        "\n",
        "ax2[1].imshow(template_scaled, cmap='gray')\n",
        "ax2[1].set_title('Template Scaled x1.5')\n",
        "ax2[1].axis('off')\n",
        "\n",
        "ax2[2].imshow(result_scaled, cmap='viridis')\n",
        "ax2[2].set_title('Matching Result (Scaled)')\n",
        "ax2[2].plot(x_scl, y_scl, 'r+', markersize=10)\n",
        "ax2[2].axis('off')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
